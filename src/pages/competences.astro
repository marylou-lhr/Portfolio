---
import Layout from '../components/Layout.astro';
import '../styles/skills.css';
---

<Layout>
    <div>
        <section>
            <h1 class="intro--title">Mes compétences</h1>
            <div>
                <p>Vous trouverez ici toutes mes compétences séparés en plusieurs catégories :</p>
                <ul class="intro--list">
                    <li>Les technologies</li>
                    <li>Les frameworks</li>
                    <li>Les outils</li>
                    <li>Les soft skills</li>
                </ul>
                <p>
                    Les pourcentages affichés sont approximatifs et données en fonction de mon ressenti et de ce que je sais que je ne maîtrise pas encore.
                </p>
            </div>
        </section>
        <section>
            <h2 class="section--title">
                Les technologies
            </h2>
            <div class="section--content">
                <div id="html">
                    HTML
                    <progress value="90" max="100"> 90% </progress>
                    <span>90%</span>
                </div>
                <div id="css">
                    CSS
                    <progress value="75" max="100"> 75% </progress>
                    <span>75%</span>
                </div>
                <div id="javascript">
                    JavaScript
                    <progress value="75" max="100"> 75% </progress>
                    <span>75%</span>
                </div>
                <div id="php">
                    PHP
                    <progress value="60" max="100"> 60% </progress>
                    <span>60%</span>
                </div>
                <div id="java">
                    Java
                    <progress value="70" max="100"> 70% </progress>
                    <span>70%</span>
                </div>
                <div id="cplusplus">
                    C++
                    <progress value="70" max="100"> 70% </progress>
                    <span>70%</span>
                </div>
                <div id="typescript">
                    TypeScript
                    <progress value="70" max="100"> 70% </progress>
                    <span>70%</span>
                </div>
                <div id="bash">
                    Bash
                    <progress value="50" max="100"> 50% </progress>
                    <span>50%</span>
                </div>
                <div id="python">
                    Python
                    <progress value="60" max="100"> 60% </progress>
                    <span>60%</span>
                </div>
                <div id="sql">
                    SQL
                    <progress value="80" max="100"> 80% </progress>
                    <span>80%</span>
                </div>
            </div>
        </section>
        <section>
            <h2 class="section--title">
                Les frameworks
            </h2>
            <div class="section--content">
                <div id="reactjs">
                    ReactJS
                    <progress value="70" max="100"> 70% </progress>
                    <span>70%</span>
                </div>
                <div id="astro">
                    Astro
                    <progress value="75" max="100"> 75% </progress>
                    <span>75%</span>
                </div>
                <div id="angular">
                    Angular
                    <progress value="70" max="100"> 70% </progress>
                    <span>70%</span>
                </div>
                <div id="laravel">
                    Laravel
                    <progress value="65" max="100"> 65% </progress>
                    <span>65%</span>
                </div>
                <div id="twig">
                    Twig
                    <progress value="80" max="100"> 80% </progress>
                    <span>80%</span>
                </div>
                <div id="qt">
                    Qt
                    <progress value="50" max="100"> 50% </progress>
                    <span>50%</span>
                </div>
            </div>
        </section>
        <section>
            <h2 class="section--title">
                Les outils
            </h2>
            <div class="section--content">
                <div id="vscode">
                    Visual Studio Code
                    <progress value="60" max="100"> 60% </progress>
                    <span>60%</span>
                </div>
                <div id="git">
                    Git - GitHub
                    <progress value="70" max="100"> 70% </progress>
                    <span>70%</span>
                </div>
                <div id="clickup">
                    ClickUp
                    <progress value="65" max="100"> 65% </progress>
                    <span>65%</span>
                </div>
                <div id="wordpress">
                    WordPress
                    <progress value="70" max="100"> 70% </progress>
                    <span>70%</span>
                </div>
                <div id="microsoft">
                    Microsoft 365
                    <progress value="60" max="100"> 60% </progress>
                    <span>60%</span>
                </div>
                <div id="google">
                    Google Workspace
                    <progress value="60" max="100"> 60% </progress>
                    <span>60%</span>
                </div>
                <div id="notion">
                    Notion
                    <progress value="75" max="100"> 75% </progress>
                    <span>75%</span>
                </div>
                <div id="drupal">
                    Drupal
                    <progress value="50" max="100"> 50% </progress>
                    <span>50%</span>
                </div>
            </div>
            <div class="warning">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M256 0c14.7 0 28.2 8.1 35.2 21l216 400c6.7 12.4 6.4 27.4-.8 39.5S486.1 480 472 480L40 480c-14.1 0-27.2-7.4-34.4-19.5s-7.5-27.1-.8-39.5l216-400c7-12.9 20.5-21 35.2-21zm0 352a32 32 0 1 0 0 64 32 32 0 1 0 0-64zm0-192c-18.2 0-32.7 15.5-31.4 33.7l7.4 104c.9 12.5 11.4 22.3 23.9 22.3 12.6 0 23-9.7 23.9-22.3l7.4-104c1.3-18.2-13.1-33.7-31.4-33.7z"/></svg>
                <p>La liste n'est pas exhaustive.</p>
            </div>
        </section>
        <section>
            <h2 class="section--title">
                Les soft skills
            </h2>
            <div class="section--content soft-skill">
                <div class="soft-skill">
                    <p id="francais">Français</p>
                    <span>Native</span>
                </div>
                <div class="soft-skill">
                    <p id="anglais">Anglais</p>
                    <span>Niveau C1</span>
                </div>
                <div class="soft-skill">
                    <p id="autonome">Autonomie</p>
                    <span>J'aime avoir de l'autonomie, notamment dans mon travail.</span>
                </div>
                <div class="soft-skill">
                    <p id="curiosite">Curiosité</p>
                    <span>J'ai toujours été très curieuse et j'adore faire des découvertes.</span>
                </div>
                <div class="soft-skill">
                    <p id="adaptabilite">Adaptabilité</p>
                    <span>Tout au long de ma vie, je fais de mon mieux pour m'adapter à toutes sortes de situations.</span>
                </div>
            </div>
        </section>
    </div>
</Layout>