---
import Layout from '../components/Layout.astro';
import '../styles/projects.css';
import gds from '/src/assets/gds.png?url';
import vhs from "/src/assets/vhs.png?url";
import ld from "/src/assets/lecteurDiaporama.png?url";
import isr from "/src/assets/installation_services_reseau.png?url";
import bd from "/src/assets/creation_bd.png?url";
---

<Layout>
    <div>
        <section>
            <h1>Mes projets</h1>
            <p>
                Vous trouverez plusieurs exemples de projets universitaires effectués au cours des années, et de différentes natures (web, base de données...)
            </p>
        </section>
        <section>
           <div class="projects">
				<div class="projects-bloc">
					<img src={ gds } alt="">
					<div>
						<h4 class="projects-bloc--title">Gestion des stages</h4>
						<p class="projects-bloc--text">
							Application web interne à l'université destiné à la gestion des stages.
						</p>
						<ul class="projects-bloc_skills">
							<li>
								Angular - TypeScript
							</li>
							<li>
								PHP - Laravel
							</li>
							<li>
								HTML
							</li>
							<li>
								CSS
							</li>
						</ul>
                        <a href="/Portfolio/projets/gestion-des-stages" class="projects-bloc_btn">
                            En savoir plus
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                                <!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                            </svg>
                        </a>
					</div>
				</div>
				<div class="projects-bloc">
					<img src={ vhs } alt="">
					<div>
						<h4 class="projects-bloc--title">Video Home Share</h4>
						<p class="projects-bloc--text">
							Application web permettant aux utilisateurs de discuter de films et séries à travers un forum et un réseau social intégré.
						</p>
						<ul class="projects-bloc_skills">
							<li id="php">
								PHP - Twig
							</li>
							<li id="css">
								CSS
							</li>
							<li id="javascript">
								JavaScript
							</li>
						</ul>
                        <a href={ vhs } class="projects-bloc_btn">
                            En savoir plus
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                                <!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                            </svg>
                        </a>
					</div>
				</div>
                <div class="projects-bloc">
					<img src={ ld } alt="">
					<div>
						<h4 class="projects-bloc--title">Lecteur de diaporama</h4>
						<p class="projects-bloc--text">
							Application permettant de visionner les images d'un dossier.
						</p>
						<ul class="projects-bloc_skills">
							<li>
								C++
							</li>
							<li>
								Qt - QtCreator
							</li>
						</ul>
                        <a href="/Portfolio/projets/lecteurDiaporama" class="projects-bloc_btn">
                            En savoir plus
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                                <!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                            </svg>
                        </a>
					</div>
				</div>
                <div class="projects-bloc">
                    <img src={ isr } alt="">
                    <div>
                        <h4 class="projects-bloc--title">Installation de services réseau</h4>
                        <p class="projects-bloc--text">
                            Utilisation d'une application de simulation de réseau pour installer des services dans un réseau local.
                            Ce projet a pour but d'apprendre à installer des services sur un réseau d'entreprise séparés en plusieurs sous-réseaux : Administratif, Internet, Entrepôt et Serveur.
                            Dans ce réseau, les appareils auront accès à Internet, au serveur FTP, et au site web local de l'entreposage.
                        </p>
                        <ul class="projects-bloc_skills">
                            <li>
                                Marionnet
                            </li>
                            <li>
                                Bash
                            </li>
                            <li>
                                HTML
                            </li>
                        </ul>
                        <a href="/Portfolio/projets/installation-services-reseau" class="projects-bloc_btn">
                            En savoir plus
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                                <!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                            </svg>
                        </a>
                    </div>
				</div>
                <div class="projects-bloc">
                    <img src= alt="">
                    <div>
                        <h4 class="projects-bloc--title">Création d'une base de données</h4>
                        <p class="projects-bloc--text">
                            Création d'une base de données SQL pour une chaîne de magasins.
                        </p>
                        <ul class="projects-bloc_skills">
                            <li>
                                SQL
                            </li>
                            <li>
                                Looping
                            </li>
                        </ul>
                        <a href={ bd } class="projects-bloc_btn">
                            En savoir plus
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                                <!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                            </svg>
                        </a>
                    </div>
				</div>
			</div>
        </section>
    </div>
</Layout>