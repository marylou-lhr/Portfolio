---
import Layout from '../components/Layout.astro';
import '../styles/index.css';
---

<Layout>
	<div>
		<section class="hero-section">
			<img src="/src/assets/pfp_no_bg.png" class="pfp" />
			<div>
				<h1 class="hero-section_title">Marylou Lohier</h1>
				<h2 class="hero-section_paragraph">Etudiante en informatique</p>
				<h2 class="hero-section_paragraph">Développeuse web</p>
				<!-- Liens vers projets -->
			</div>
		</section>
		<section>
			<h3>À propos de moi</h3>
			<div class="a-propos">
				<p>Je suis étudiante en alternance de 3e année en BUT Informatique à Anglet et développeuse web chez Panda One, une petite agence web à Anglet</p>
			</div>
			<div class="timeline">
				<div class="event">
					<div class="title">
						<h3>Avril 2025 - Juin 2025</h3>
					</div>
					<div class="event-content">
						<p>Stagiaire développeuse web chez Panda One</p>
					</div>
				</div>
				<div class="event">
					<div class="title">
						<h3>Juillet 2025 - Août 2025</h3>
					</div>
					<div class="event-content">
						<p>Développeuse web chez Panda One</p>
					</div>
				</div>
				<div class="event">
					<div class="title">
						<h3>Septembre 2025 - Août 2026</h3>
					</div>
					<div class="event-content">
						<p>Etudiante alternante en BUT Informatique à l'IUT de Bayonne et du Pays Basque</p>
						<p>Développeuse web chez Panda One</p>
					</div>
				</div>
			</div>
		</section>
		<section>
			<h3 class="skills-title">Mes compétences principales</h3>
			<div class="skills">
				<div class="skills-bloc">
					<h5 class="skills-bloc-title">Langages de programmation</h5>
					<ul class="skills-bloc-list">
						<li id="html">
							HTML
						</li>
						<li id="css">
							CSS
						</li>
						<li id="javascript">
							JavaScript
						</li>
					</ul>
				</div>
				<div class="skills-bloc">
					<h5 class="skills-bloc-title">Frameworks</h5>
					<ul class="skills-bloc-list">
						<li id="reactjs">
							ReactJS
						</li>
						<li id="angular">
							Angular
						</li>
						<li id="laravel">
							Laravel
						</li>
					</ul>
				</div>
				<div class="skills-bloc">
					<h5 class="skills-bloc-title">Outils</h5>
					<ul class="skills-bloc-list">
						<li id="vscode">
							Visual Studio Code
						</li>
						<li id="clickup">
							ClickUp
						</li>
						<li id="git">
							Git - GitHub
						</li>
					</ul>
				</div>
				<div class="skills-bloc">
					<h5 class="skills-bloc-title">Soft skills</h5>
					<ul class="skills-bloc-list">
						<li id="autonome">
							Autonomie
						</li>
						<li id="curiosite">
							Curiosité
						</li>
						<li id="adaptabilite">
							Adaptabilité
						</li>
					</ul>
				</div>
				<div class="skills-bloc">
					<h5 class="skills-bloc-title">Langues</h5>
					<ul class="skills-bloc-list">
						<li id="francais">
							Français (natif)
						</li>
						<li id="anglais">
							Anglais (C1)
						</li>
					</ul>
				</div>
				<div class="skills-bloc">
					<h5 class="skills-bloc-title">Centres d'intérêt</h5>
					<ul class="skills-bloc-list">
						<li id="technologie">
							Technologie
						</li>
						<li id="psychologie">
							Psychologie
						</li>
						<li id="design">
							Design
						</li>
					</ul>
				</div>
			</div>
		</section>
		<section>
			<h3 class="projects-title">Mes derniers projets universitaires</h3>
			<div class="projects">
				<div class="projects-bloc">
					<h4 class="projects-bloc-title">Gestion des stages</h4>
					<img src="/src/assets/gds.png" alt="">
					<div>
						<p class="projects-bloc_text">
							Application web interne à l'université destiné à la gestion des stages.
						</p>
						<ul class="projects-bloc_skills">
							<li>
								Angular - TypeScript
							</li>
							<li>
								PHP - Laravel
							</li>
							<li>
								HTML
							</li>
							<li>
								CSS
							</li>
						</ul>
					</div>
				</div>
				<div class="projects-bloc">
					<h4 class="projects-bloc-title">Video Home Share</h4>
					<img src="/src/assets/vhs.png" alt="">
					<div>
						<p class="projects-bloc_text">
							Application web permettant aux utilisateurs de discuter de films et séries à travers un forum et un réseau social intégré.
						</p>
						<ul class="projects-bloc_skills">
							<li id="php">
								PHP - Twig
							</li>
							<li id="css">
								CSS
							</li>
							<li id="javascript">
								JavaScript
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>
		<section>
			<h3>Intéressé(e) par mon CV ?</h3>
			<a href="src/assets/cv_lohier_marylou.pdf" download class="download-btn">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
					<!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
					<path d="M256 32c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 210.7-41.4-41.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l96 96c12.5 12.5 32.8 12.5 45.3 0l96-96c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 242.7 256 32zM64 320c-35.3 0-64 28.7-64 64l0 32c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-32c0-35.3-28.7-64-64-64l-46.9 0-56.6 56.6c-31.2 31.2-81.9 31.2-113.1 0L110.9 320 64 320zm304 56a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"/>
				</svg>
				Télécharger le CV
			</a>
		</section>
	</div>
</Layout>