---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="header">
	<nav class="menu">
		<h2><a href="/Portfolio">👩🏻‍💻 {SITE_TITLE}</a></h2>
		<div class="links">
			<div class="internal-links">
				<HeaderLink href="/Portfolio">Accueil</HeaderLink>
				<HeaderLink href="/Portfolio/a-propos">A propos</HeaderLink>
				<HeaderLink href="/Portfolio/competences">Compétences</HeaderLink>
				<HeaderLink href="/Portfolio/projets">Projets</HeaderLink>
				<HeaderLink href="/Portfolio/side-quests">Quêtes secondaires</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://www.linkedin.com/in/marylou-lohier/" target="_blank">
					<svg width="32" height="32" viewBox="0 0 128 128" aria-hidden="true">
						<path fill="currentColor" d="M116 3H12a9 9 0 0 0-9 8.8v104.4a9 9 0 0 0 9 8.8h104a9 9 0 0 0 9-8.8V11.8a9 9 0 0 0-9-8.8M39.2 107H21V48.7h18zm-9-66.2a10.5 10.5 0 1 1 10.5-10.5A10.5 10.5 0 0 1 30 40.8zM107 107H88.9V78.7c0-6.8-.1-15.5-9.4-15.5s-10.9 7.4-10.9 15V107h-18V48.7h17.3v8h.2a19 19 0 0 1 17.2-9.4c18.3 0 21.7 12 21.7 27.7z"></path>
					</svg>
				</a>
				<a href="https://github.com/marylou-lhr" target="_blank">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z">
						</path>
					</svg>
				</a>
			</div>
		</div>
		<button type="button" id="mobile_menu" class="btn-menu">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
				<!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
				<path d="M0 96C0 78.3 14.3 64 32 64l384 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 128C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32l384 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 288c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32L32 448c-17.7 0-32-14.3-32-32s14.3-32 32-32l384 0c17.7 0 32 14.3 32 32z"/>
			</svg>
		</button>
	</nav>
</header>
<script>
    function toggleMenu() {
        let link_div = document.getElementsByClassName("links")[0];
        link_div.classList.toggle("active");
    }

    document.addEventListener("DOMContentLoaded", function() {
        let mobile_menu = document.getElementById("mobile_menu");
        if (mobile_menu) {
            mobile_menu.addEventListener("click", toggleMenu);
        }
    });
</script>
<style>
	.header {
		margin: 15px auto 30px auto;
		padding: 1em;
		background: var(--bkg);
		border-radius: 15px;
		width: 1440px;
		max-width: calc(100% - 2em);
		justify-self: center;
	}
	h2 {
		margin: 0;
		font-size: 28px;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.menu {
		display: flex;
		align-items: center;
		justify-content: space-between;
		overflow: hidden;
	}
	.menu a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	.links {
		display: flex;
		justify-content: space-between;
		max-width: 950px;
		width: 100%;
	}
	.menu a.active {
		color: var(--accent);
	}
	.menu a:hover {
		text-decoration: none;
		color: var(--accent);
	}

	.menu .btn-menu,
	.btn-menu
	{
		cursor: pointer;
	}

	.btn-menu
	{
		width: 25px;
		height: 25px;
		display: none;
	}

	.btn-menu svg {
		fill: var(--black);
		width: 25px;
		height: 25px;
	}

	.social-links,
	.social-links a {
		display: flex;
	}

	.active {
		display: block !important;
	}

	@media (max-width: 720px) {
		.header
		{
			padding: 1rem;
		}
	}

	@media screen and (max-width: 1024px) {
		
		.btn-menu
		{
			display: block;
		}
		.menu.active {
			position: relative;
			top: 0;
			right: 0;
		}

		.menu svg
		{
			display: block;
			float: right;
		}

		.links {
			display: block;
			width: auto;
		}

		.social-links {
			display: none;
		}

		.internal-links {
			top: 80px;
			left: 0;
			position: absolute;
			background-color: var(--bkg);
			margin-left: 20px;
			width: calc(100% - 2em);
			text-align: center;
		}
	}

</style>
